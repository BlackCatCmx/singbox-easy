#!/usr/bin/env bash

set -Eeuo pipefail

readonly PROJECT_REPO="BlackCatCmx/singbox-easy"
readonly INSTALL_DIR="/etc/singbox-easy"
readonly CORE_BIN="${INSTALL_DIR}/bin/sing-box"
readonly CONFIG_FILE="${INSTALL_DIR}/config.json"
readonly CONF_DIR="${INSTALL_DIR}/conf.d"
readonly STATE_DIR="${INSTALL_DIR}/state"
readonly TLS_DIR="${INSTALL_DIR}/tls"
readonly SERVICE_NAME="singbox-easy.service"
readonly SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}"
readonly MANAGER_BIN="/usr/local/bin/sbe"

log() {
    printf '[singbox-easy] %s\n' "$*"
}

die() {
    printf '[singbox-easy] ERROR: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
singbox-easy - minimal sing-box server manager

Usage:
  sbe add <reality|hysteria2|shadowsocks> [NAME] [options]
  sbe list
  sbe show <NAME>
  sbe set <NAME> <port|address|sni> <VALUE>
  sbe remove <NAME>
  sbe check
  sbe status
  sbe start|stop|restart
  sbe logs
  sbe update [--no-restart]
  sbe uninstall
  sbe version

Add options:
  --port PORT        Use a specific listen port.
  --address ADDRESS  Public IPv4, IPv6, or domain used in the share URL.
  --sni DOMAIN       Reality handshake server (default: www.cloudflare.com).
  --port-range RANGE Hysteria2 UDP hopping range, e.g. 20000:30000.
                     The range start is the listen/fallback port.

Examples:
  sbe add reality home
  sbe add hysteria2 mobile --port 443
  sbe add hysteria2 mobile --port-range 20000:30000
  sbe add shadowsocks backup --address proxy.example.com
  sbe set home sni www.microsoft.com
  sbe set mobile port 8443
EOF
}

require_root() {
    [[ ${EUID} -eq 0 ]] || die "this command must run as root"
}

require_installation() {
    [[ -x $CORE_BIN && -f $CONFIG_FILE && -d $CONF_DIR && -d $STATE_DIR ]] || {
        die "singbox-easy is not installed correctly"
    }
}

normalize_protocol() {
    case "${1,,}" in
    reality | vless | vless-reality | vless_reality) printf 'reality\n' ;;
    hysteria2 | hysteria | hy2) printf 'hysteria2\n' ;;
    shadowsocks | shadow | ss | ss2022) printf 'shadowsocks\n' ;;
    *) die "unsupported protocol: $1" ;;
    esac
}

validate_name() {
    [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$ ]] || {
        die "profile name must match [A-Za-z0-9][A-Za-z0-9_-]{0,31}"
    }
}

validate_port() {
    [[ $1 =~ ^[0-9]+$ ]] && ((1 <= 10#$1 && 10#$1 <= 65535)) || {
        die "port must be between 1 and 65535"
    }
}

normalize_port_range() {
    local range=${1/-/:} start end
    [[ $range =~ ^([0-9]+):([0-9]+)$ ]] || die "port range must use START:END"
    start=${BASH_REMATCH[1]}
    end=${BASH_REMATCH[2]}
    validate_port "$start"
    validate_port "$end"
    ((10#$start < 10#$end)) || die "port range must be ascending"
    printf '%s:%s\n' "$((10#$start))" "$((10#$end))"
}

port_in_use() {
    local port=$1
    if command -v ss >/dev/null; then
        ss -H -lntu | awk '{print $5}' | grep -Eq "(^|:)$port$" && return 0
    fi
    grep -Rqs '"listen_port"[[:space:]]*:[[:space:]]*'"$port"'\([,[:space:]]\|$\)' "$CONF_DIR" && return 0
    return 1
}

random_port() {
    local port
    for _ in {1..128}; do
        port=$(shuf -i 10000-60000 -n 1)
        if ! port_in_use "$port"; then
            printf '%s\n' "$port"
            return
        fi
    done
    die "could not find an available port"
}

validate_address() {
    [[ $1 != *['/?#@']* && -n $1 ]] || die "invalid public address: $1"
}

validate_sni() {
    [[ $1 =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ && $1 == *.* ]] || {
        die "invalid SNI domain: $1"
    }
}

public_address() {
    local response address
    response=$(curl -4 -fsSL --max-time 10 https://one.one.one.one/cdn-cgi/trace 2>/dev/null || true)
    address=$(awk -F= '$1 == "ip" {print $2; exit}' <<<"$response")
    if [[ -z $address ]]; then
        response=$(curl -6 -fsSL --max-time 10 https://one.one.one.one/cdn-cgi/trace 2>/dev/null || true)
        address=$(awk -F= '$1 == "ip" {print $2; exit}' <<<"$response")
    fi
    [[ -n $address ]] || die "could not detect the public address; use --address"
    printf '%s\n' "$address"
}

url_host() {
    if [[ $1 == *:* && $1 != \[*\] ]]; then
        printf '[%s]' "$1"
    else
        printf '%s' "$1"
    fi
}

url_encode() {
    jq -rn --arg value "$1" '$value | @uri'
}

ensure_tls_certificate() {
    if [[ -s ${TLS_DIR}/server.crt && -s ${TLS_DIR}/server.key ]]; then
        return
    fi

    log "generating a self-signed TLS certificate"
    openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 3650 \
        -subj '/CN=singbox-easy' \
        -keyout "${TLS_DIR}/server.key" \
        -out "${TLS_DIR}/server.crt" >/dev/null 2>&1
    chmod 0600 "${TLS_DIR}/server.key" "${TLS_DIR}/server.crt"
}

generate_reality_keys() {
    local output private_key public_key
    output=$($CORE_BIN generate reality-keypair)
    private_key=$(awk -F: 'tolower($1) ~ /private/ {sub(/^[[:space:]]+/, "", $2); print $2; exit}' <<<"$output")
    public_key=$(awk -F: 'tolower($1) ~ /public/ {sub(/^[[:space:]]+/, "", $2); print $2; exit}' <<<"$output")
    [[ -n $private_key && -n $public_key ]] || die "could not parse the Reality key pair"
    printf '%s\t%s\n' "$private_key" "$public_key"
}

write_reality_profile() {
    local name=$1 port=$2 address=$3 sni=$4 conf_file=$5 state_file=$6
    local uuid key_pair private_key public_key details
    uuid=$($CORE_BIN generate uuid)
    key_pair=$(generate_reality_keys)
    IFS=$'\t' read -r private_key public_key <<<"$key_pair"

    jq -n \
        --arg tag "$name" \
        --arg uuid "$uuid" \
        --arg sni "$sni" \
        --arg private_key "$private_key" \
        --argjson port "$port" \
        '{
          inbounds: [{
            type: "vless",
            tag: $tag,
            listen: "::",
            listen_port: $port,
            users: [{uuid: $uuid, flow: "xtls-rprx-vision"}],
            tls: {
              enabled: true,
              server_name: $sni,
              reality: {
                enabled: true,
                handshake: {server: $sni, server_port: 443},
                private_key: $private_key,
                short_id: [""]
              }
            }
          }]
        }' >"$conf_file"

    details=$(jq -nc --arg uuid "$uuid" --arg public_key "$public_key" --arg sni "$sni" \
        '{uuid: $uuid, public_key: $public_key, sni: $sni}')
    write_state "$state_file" "$name" reality "$address" "$port" "$details"
}

write_hysteria2_profile() {
    local name=$1 port=$2 address=$3 port_range=$4 conf_file=$5 state_file=$6
    local password details
    ensure_tls_certificate
    password=$($CORE_BIN generate rand 32 --base64)

    jq -n \
        --arg tag "$name" \
        --arg password "$password" \
        --arg certificate "${TLS_DIR}/server.crt" \
        --arg key "${TLS_DIR}/server.key" \
        --argjson port "$port" \
        '{
          inbounds: [{
            type: "hysteria2",
            tag: $tag,
            listen: "::",
            listen_port: $port,
            users: [{password: $password}],
            tls: {
              enabled: true,
              alpn: ["h3"],
              certificate_path: $certificate,
              key_path: $key
            }
          }]
        }' >"$conf_file"

    if [[ -n $port_range ]]; then
        details=$(jq -nc --arg password "$password" --arg port_range "$port_range" \
            '{password: $password, port_range: $port_range, hop_active: true}')
    else
        details=$(jq -nc --arg password "$password" \
            '{password: $password, port_range: "", hop_active: false}')
    fi
    write_state "$state_file" "$name" hysteria2 "$address" "$port" "$details"
}

write_shadowsocks_profile() {
    local name=$1 port=$2 address=$3 conf_file=$4 state_file=$5
    local method password details
    method='2022-blake3-aes-256-gcm'
    password=$($CORE_BIN generate rand 32 --base64)

    jq -n \
        --arg tag "$name" \
        --arg method "$method" \
        --arg password "$password" \
        --argjson port "$port" \
        '{
          inbounds: [{
            type: "shadowsocks",
            tag: $tag,
            listen: "::",
            listen_port: $port,
            method: $method,
            password: $password
          }]
        }' >"$conf_file"

    details=$(jq -nc --arg method "$method" --arg password "$password" \
        '{method: $method, password: $password}')
    write_state "$state_file" "$name" shadowsocks "$address" "$port" "$details"
}

write_state() {
    local state_file=$1 name=$2 protocol=$3 address=$4 port=$5 details=$6
    jq -n \
        --arg name "$name" \
        --arg protocol "$protocol" \
        --arg address "$address" \
        --argjson port "$port" \
        --argjson details "$details" \
        '{name: $name, protocol: $protocol, address: $address, port: $port} + $details' \
        >"$state_file"
    refresh_state_url "$state_file"
}

refresh_state_url() {
    local state_file=$1 protocol name address port host url
    protocol=$(jq -er '.protocol' "$state_file")
    name=$(jq -er '.name' "$state_file")
    address=$(jq -er '.address' "$state_file")
    port=$(jq -er '.port' "$state_file")
    host=$(url_host "$address")

    case "$protocol" in
    reality)
        local uuid public_key sni encoded_pbk
        uuid=$(jq -er '.uuid' "$state_file")
        public_key=$(jq -er '.public_key' "$state_file")
        sni=$(jq -er '.sni' "$state_file")
        encoded_pbk=$(url_encode "$public_key")
        url="vless://${uuid}@${host}:${port}?encryption=none&security=reality&flow=xtls-rprx-vision&type=tcp&sni=${sni}&pbk=${encoded_pbk}&fp=chrome#${name}"
        ;;
    hysteria2)
        local password encoded_password port_range hop_active client_port
        password=$(jq -er '.password' "$state_file")
        encoded_password=$(url_encode "$password")
        port_range=$(jq -r '.port_range // ""' "$state_file")
        hop_active=$(jq -r '.hop_active // false' "$state_file")
        client_port=$port
        if [[ $hop_active == true && -n $port_range ]]; then
            client_port=${port_range/:/-}
        fi
        url="hysteria2://${encoded_password}@${host}:${client_port}?insecure=1#${name}"
        ;;
    shadowsocks)
        local method password userinfo
        method=$(jq -er '.method' "$state_file")
        password=$(jq -er '.password' "$state_file")
        userinfo=$(printf '%s:%s' "$method" "$password" | base64 -w 0)
        url="ss://${userinfo}@${host}:${port}#${name}"
        ;;
    esac

    jq --arg url "$url" '.url = $url' "$state_file" >"${state_file}.url"
    mv "${state_file}.url" "$state_file"
}

firewall_profile_values() {
    local state_file=$1 protocol port port_range start end redirect_range
    protocol=$(jq -r '.protocol' "$state_file")
    port_range=$(jq -r '.port_range // ""' "$state_file")
    [[ $protocol == hysteria2 && -n $port_range ]] || return 1
    port=$(jq -er '.port' "$state_file")
    start=${port_range%%:*}
    end=${port_range##*:}
    [[ $port == "$start" ]] || return 1
    if ((10#$start + 1 == 10#$end)); then
        redirect_range=$end
    else
        redirect_range="$((10#$start + 1)):$end"
    fi
    printf '%s\t%s\n' "$port" "$redirect_range"
}

firewall_add_profile() {
    local state_file=$1 values port redirect_range
    values=$(firewall_profile_values "$state_file") || return 0
    IFS=$'\t' read -r port redirect_range <<<"$values"
    command -v iptables >/dev/null || return 1

    if ! iptables -w 5 -t nat -C PREROUTING -p udp --dport "$redirect_range" \
        -j REDIRECT --to-ports "$port" 2>/dev/null; then
        iptables -w 5 -t nat -A PREROUTING -p udp --dport "$redirect_range" \
            -j REDIRECT --to-ports "$port" || return 1
    fi

    if command -v ip6tables >/dev/null; then
        ip6tables -w 5 -t nat -C PREROUTING -p udp --dport "$redirect_range" \
            -j REDIRECT --to-ports "$port" 2>/dev/null ||
            ip6tables -w 5 -t nat -A PREROUTING -p udp --dport "$redirect_range" \
                -j REDIRECT --to-ports "$port" 2>/dev/null ||
            log "IPv6 hopping rule could not be installed; IPv4 remains active"
    fi
}

firewall_remove_profile() {
    local state_file=$1 values port redirect_range
    values=$(firewall_profile_values "$state_file") || return 0
    IFS=$'\t' read -r port redirect_range <<<"$values"

    if command -v iptables >/dev/null; then
        while iptables -w 5 -t nat -C PREROUTING -p udp --dport "$redirect_range" \
            -j REDIRECT --to-ports "$port" 2>/dev/null; do
            iptables -w 5 -t nat -D PREROUTING -p udp --dport "$redirect_range" \
                -j REDIRECT --to-ports "$port"
        done
    fi
    if command -v ip6tables >/dev/null; then
        while ip6tables -w 5 -t nat -C PREROUTING -p udp --dport "$redirect_range" \
            -j REDIRECT --to-ports "$port" 2>/dev/null; do
            ip6tables -w 5 -t nat -D PREROUTING -p udp --dport "$redirect_range" \
                -j REDIRECT --to-ports "$port"
        done
    fi
}

disable_profile_hopping() {
    local state_file=$1 tmp_state="${1}.firewall"
    jq '.hop_active = false' "$state_file" >"$tmp_state"
    chmod 0600 "$tmp_state"
    mv "$tmp_state" "$state_file"
    refresh_state_url "$state_file"
}

firewall_add_all() {
    local state_file hop_active
    for state_file in "$STATE_DIR"/*.json; do
        [[ -f $state_file ]] || continue
        hop_active=$(jq -r '.hop_active // false' "$state_file")
        [[ $hop_active == true ]] || continue
        if ! firewall_add_profile "$state_file"; then
            log "Hysteria2 port hopping failed for $(jq -r '.name' "$state_file"); falling back to port $(jq -r '.port' "$state_file")"
            firewall_remove_profile "$state_file"
            disable_profile_hopping "$state_file"
        fi
    done
}

firewall_remove_all() {
    local state_file
    for state_file in "$STATE_DIR"/*.json; do
        [[ -f $state_file ]] || continue
        firewall_remove_profile "$state_file"
    done
}

check_config() {
    "$CORE_BIN" check -c "$CONFIG_FILE" -C "$CONF_DIR"
}

has_profiles() {
    compgen -G "${CONF_DIR}/*.json" >/dev/null
}

add_profile() {
    (($# >= 1)) || die "usage: sbe add <protocol> [NAME] [options]"
    local protocol name='' port='' address='' sni='' port_range=''
    local conf_file state_file tmp_conf tmp_state
    protocol=$(normalize_protocol "$1")
    shift

    if (($#)) && [[ $1 != --* ]]; then
        name=$1
        shift
    fi

    while (($#)); do
        case "$1" in
        --port)
            (($# >= 2)) || die "--port requires a value"
            port=$2
            shift 2
            ;;
        --address)
            (($# >= 2)) || die "--address requires a value"
            address=$2
            shift 2
            ;;
        --sni)
            (($# >= 2)) || die "--sni requires a value"
            sni=$2
            shift 2
            ;;
        --port-range | --hy2-port-range)
            (($# >= 2)) || die "$1 requires a value"
            port_range=$2
            shift 2
            ;;
        *) die "unknown add option: $1" ;;
        esac
    done

    if [[ -n $port ]]; then
        validate_port "$port"
        port=$((10#$port))
    fi

    if [[ -n $port_range ]]; then
        [[ $protocol == hysteria2 ]] || die "port hopping is only supported by Hysteria2"
        port_range=$(normalize_port_range "$port_range")
        local range_start=${port_range%%:*}
        [[ -z $port || $port == "$range_start" ]] || {
            die "Hysteria2 port must equal the hopping range start: $range_start"
        }
        port=$range_start
    fi

    if [[ -n $port ]]; then
        port_in_use "$port" && die "port is already in use: $port"
    else
        port=$(random_port)
    fi

    [[ -n $name ]] || name="${protocol}-${port}"
    validate_name "$name"
    [[ -n $address ]] || address=$(public_address)
    validate_address "$address"
    if [[ $protocol == reality ]]; then
        sni=${sni:-www.cloudflare.com}
        validate_sni "$sni"
    elif [[ -n $sni ]]; then
        die "--sni is only supported by Reality profiles"
    fi

    conf_file="${CONF_DIR}/${name}.json"
    state_file="${STATE_DIR}/${name}.json"
    [[ ! -e $conf_file && ! -e $state_file ]] || die "profile already exists: $name"

    tmp_conf="${conf_file}.new"
    tmp_state="${state_file}.new"
    trap 'rm -f "${tmp_conf:-}" "${tmp_state:-}"' EXIT

    case "$protocol" in
    reality) write_reality_profile "$name" "$port" "$address" "$sni" "$tmp_conf" "$tmp_state" ;;
    hysteria2) write_hysteria2_profile "$name" "$port" "$address" "$port_range" "$tmp_conf" "$tmp_state" ;;
    shadowsocks) write_shadowsocks_profile "$name" "$port" "$address" "$tmp_conf" "$tmp_state" ;;
    esac

    chmod 0600 "$tmp_conf" "$tmp_state"
    mv "$tmp_conf" "$conf_file"
    if ! check_config >/dev/null; then
        rm -f "$conf_file"
        check_config || true
        die "generated configuration failed validation"
    fi
    mv "$tmp_state" "$state_file"
    systemctl enable "$SERVICE_NAME" >/dev/null
    if ! systemctl restart "$SERVICE_NAME"; then
        if [[ $protocol == hysteria2 && -n $port_range ]]; then
            firewall_remove_profile "$state_file"
            disable_profile_hopping "$state_file"
            systemctl reset-failed "$SERVICE_NAME" >/dev/null 2>&1 || true
            systemctl restart "$SERVICE_NAME" || die "service failed with port hopping and fallback port $port"
        else
            die "service failed to start"
        fi
    fi
    systemctl is-active --quiet "$SERVICE_NAME" || die "service failed to start"
    trap - EXIT

    log "profile created: $name"
    show_profile "$name"
}

list_profiles() {
    local found=0 file
    printf '%-32s %-14s %-8s %s\n' NAME PROTOCOL PORT ADDRESS
    for file in "$STATE_DIR"/*.json; do
        [[ -e $file ]] || continue
        found=1
        jq -r '[.name, .protocol, (.port | tostring), .address] | @tsv' "$file" |
            awk -F '\t' '{printf "%-32s %-14s %-8s %s\n", $1, $2, $3, $4}'
    done
    ((found)) || printf '(no profiles)\n'
}

show_profile() {
    (($# == 1)) || die "usage: sbe show <NAME>"
    validate_name "$1"
    local state_file="${STATE_DIR}/$1.json"
    [[ -f $state_file ]] || die "profile not found: $1"
    jq -r '"Name:     \(.name)\nProtocol: \(.protocol)\nAddress:  \(.address)\nPort:     \(.port)\nURL:      \(.url)"' "$state_file"
    if [[ $(jq -r '.protocol' "$state_file") == hysteria2 ]]; then
        local port_range hop_active
        port_range=$(jq -r '.port_range // ""' "$state_file")
        hop_active=$(jq -r '.hop_active // false' "$state_file")
        if [[ -n $port_range ]]; then
            if [[ $hop_active == true ]]; then
                printf 'Hopping:  %s (active)\n' "$port_range"
            else
                printf 'Hopping:  %s (disabled; using fallback port)\n' "$port_range"
            fi
        fi
    fi
}

set_profile() {
    (($# == 3)) || die "usage: sbe set <NAME> <port|address|sni> <VALUE>"
    local name=$1 field=${2,,} value=$3
    local conf_file state_file tmp_conf tmp_state protocol old_port restart=0 hopping_disabled=0
    validate_name "$name"
    conf_file="${CONF_DIR}/${name}.json"
    state_file="${STATE_DIR}/${name}.json"
    [[ -f $conf_file && -f $state_file ]] || die "profile not found: $name"
    protocol=$(jq -er '.protocol' "$state_file")
    old_port=$(jq -er '.port' "$state_file")
    tmp_conf="${conf_file}.new"
    tmp_state="${state_file}.new"
    trap 'rm -f "${tmp_conf:-}" "${tmp_state:-}" "${tmp_state:-}.url"' EXIT

    case "$field" in
    port)
        validate_port "$value"
        if [[ $value != "$old_port" ]]; then
            port_in_use "$value" && die "port is already in use: $value"
        fi
        jq --argjson port "$value" '.inbounds[0].listen_port = $port' "$conf_file" >"$tmp_conf"
        if [[ $protocol == hysteria2 && $value != "$old_port" && $(jq -r '.port_range // ""' "$state_file") ]]; then
            jq --argjson port "$value" '.port = $port | .port_range = "" | .hop_active = false' \
                "$state_file" >"$tmp_state"
            hopping_disabled=1
        else
            jq --argjson port "$value" '.port = $port' "$state_file" >"$tmp_state"
        fi
        restart=1
        ;;
    address)
        validate_address "$value"
        cp "$conf_file" "$tmp_conf"
        jq --arg address "$value" '.address = $address' "$state_file" >"$tmp_state"
        ;;
    sni)
        [[ $protocol == reality ]] || die "SNI can only be changed for Reality profiles"
        validate_sni "$value"
        jq --arg sni "$value" \
            '.inbounds[0].tls.server_name = $sni | .inbounds[0].tls.reality.handshake.server = $sni' \
            "$conf_file" >"$tmp_conf"
        jq --arg sni "$value" '.sni = $sni' "$state_file" >"$tmp_state"
        restart=1
        ;;
    *) die "unsupported setting: $field" ;;
    esac

    "$CORE_BIN" check -c "$tmp_conf" >/dev/null
    refresh_state_url "$tmp_state"
    chmod 0600 "$tmp_conf" "$tmp_state"
    if ((hopping_disabled)); then
        firewall_remove_profile "$state_file"
    fi
    mv "$tmp_conf" "$conf_file"
    mv "$tmp_state" "$state_file"
    if ((restart)); then
        systemctl restart "$SERVICE_NAME"
        systemctl is-active --quiet "$SERVICE_NAME" || die "service failed to start"
    fi
    trap - EXIT

    if ((hopping_disabled)); then
        log "Hysteria2 port hopping was disabled because its listen port changed"
    fi
    log "profile updated: ${name} (${field})"
    show_profile "$name"
}

remove_profile() {
    (($# == 1)) || die "usage: sbe remove <NAME>"
    validate_name "$1"
    local conf_file="${CONF_DIR}/$1.json" state_file="${STATE_DIR}/$1.json"
    [[ -f $conf_file && -f $state_file ]] || die "profile not found: $1"

    firewall_remove_profile "$state_file"
    rm -f "$conf_file" "$state_file"
    check_config >/dev/null
    if has_profiles; then
        systemctl restart "$SERVICE_NAME"
    else
        systemctl disable --now "$SERVICE_NAME" >/dev/null
        log "no profiles remain; the service was disabled and stopped"
    fi
    log "profile removed: $1"
}

detect_arch() {
    case "$(uname -m)" in
    x86_64 | amd64) printf 'amd64\n' ;;
    aarch64 | arm64) printf 'arm64\n' ;;
    *) die "only AMD64 and ARM64 are supported" ;;
    esac
}

update_core() {
    local no_restart=0 was_active=0
    if (($#)); then
        [[ $1 == --no-restart && $# == 1 ]] || die "usage: sbe update [--no-restart]"
        no_restart=1
    fi
    if ((no_restart == 0)) && systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
        was_active=1
    fi

    local arch release_json version asset_name asset_url expected_digest
    local tmp_dir archive extracted extracted_dir actual_digest
    arch=$(detect_arch)
    tmp_dir=$(mktemp -d)
    trap 'rm -rf "${tmp_dir:-}"' EXIT

    release_json="${tmp_dir}/release.json"
    curl -fL --retry 3 --retry-delay 1 \
        https://api.github.com/repos/SagerNet/sing-box/releases/latest \
        -o "$release_json"
    version=$(jq -er '.tag_name' "$release_json")
    asset_name="sing-box-${version#v}-linux-${arch}.tar.gz"
    asset_url=$(jq -er --arg name "$asset_name" '.assets[] | select(.name == $name) | .browser_download_url' "$release_json")
    expected_digest=$(jq -er --arg name "$asset_name" '.assets[] | select(.name == $name) | .digest | select(startswith("sha256:")) | sub("^sha256:"; "")' "$release_json")

    log "downloading sing-box ${version} for ${arch}"
    archive="${tmp_dir}/${asset_name}"
    curl -fL --retry 3 --retry-delay 1 "$asset_url" -o "$archive"
    actual_digest=$(sha256sum "$archive" | awk '{print $1}')
    [[ $actual_digest == "$expected_digest" ]] || die "sing-box archive checksum mismatch"

    tar -tzf "$archive" | grep -Eq '^sing-box-[^/]+/sing-box$' || die "sing-box archive layout is invalid"
    tar -xzf "$archive" -C "$tmp_dir"
    extracted_dir="${tmp_dir}/sing-box-${version#v}-linux-${arch}"
    extracted="${extracted_dir}/sing-box"
    [[ -f $extracted ]] || die "sing-box binary is missing from the archive"
    install -m 0755 "$extracted" "${CORE_BIN}.new"
    mv "${CORE_BIN}.new" "$CORE_BIN"
    if [[ -f ${extracted_dir}/libcronet.so ]]; then
        install -m 0644 "${extracted_dir}/libcronet.so" "${INSTALL_DIR}/bin/libcronet.so.new"
        mv "${INSTALL_DIR}/bin/libcronet.so.new" "${INSTALL_DIR}/bin/libcronet.so"
    else
        rm -f "${INSTALL_DIR}/bin/libcronet.so"
    fi

    if [[ -f $CONFIG_FILE ]]; then
        check_config >/dev/null
    fi
    if ((was_active)); then
        systemctl restart "$SERVICE_NAME"
    fi
    trap - EXIT
    rm -rf "$tmp_dir"
    log "sing-box updated to ${version}"
}

uninstall_all() {
    systemctl disable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
    if [[ -d $STATE_DIR ]]; then
        firewall_remove_all
    fi
    rm -f "$SERVICE_FILE"
    systemctl daemon-reload
    systemctl reset-failed "$SERVICE_NAME" >/dev/null 2>&1 || true
    rm -rf "$INSTALL_DIR"
    rm -f "$MANAGER_BIN"
    printf '[singbox-easy] uninstalled; all configurations were removed\n'
}

show_status() {
    systemctl --no-pager --full status "$SERVICE_NAME" || true
}

show_version() {
    "$CORE_BIN" version | head -n 1
    printf 'singbox-easy manager: 0.1.0\n'
}

main() {
    (($#)) || {
        usage
        exit 0
    }

    case "$1" in
    -h | --help | help)
        usage
        ;;
    uninstall)
        require_root
        uninstall_all
        ;;
    update)
        require_root
        shift
        update_core "$@"
        ;;
    firewall-add)
        require_root
        require_installation
        firewall_add_all
        ;;
    firewall-remove)
        require_root
        require_installation
        firewall_remove_all
        ;;
    *)
        require_root
        require_installation
        case "$1" in
        add) shift; add_profile "$@" ;;
        list | ls) list_profiles ;;
        show) shift; show_profile "$@" ;;
        set) shift; set_profile "$@" ;;
        remove | rm) shift; remove_profile "$@" ;;
        check) check_config ;;
        status) show_status ;;
        start | restart)
            has_profiles || die "no profiles exist; add a profile first"
            systemctl "$1" "$SERVICE_NAME"
            ;;
        stop) systemctl stop "$SERVICE_NAME" ;;
        logs) journalctl -u "$SERVICE_NAME" -f ;;
        version | -v | --version) show_version ;;
        *) die "unknown command: $1" ;;
        esac
        ;;
    esac
}

main "$@"
